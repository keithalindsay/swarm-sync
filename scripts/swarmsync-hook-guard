#!/bin/sh
# Fast opt-in guard for the swarm-sync Claude Code hooks.
#
# Wired into settings.json instead of calling swarmsync-hook directly, this makes
# NORMAL (non-coordinated) editing pay ~zero overhead: when swarm-sync is not
# activated it exits 0 immediately without ever starting Python. It only launches
# the real adapter when a coordinated session is active:
#   - env SWARMSYNC_ACTIVE is set, OR
#   - a .swarmsync-active marker file exists at the project root.
#
# Fail-open by construction: if the adapter is missing or errors, editing still works.
#
# HOOK_BIN resolution (no hardcoded path -- this script must keep working
# regardless of where the repo/venv is checked out, or under an install that
# isn't a venv at all):
#   1. `command -v swarmsync-hook` -- whatever the console script resolves to
#      on PATH (an activated venv, a pipx shim, a system install, ...).
#   2. Fall back to the sibling `../.venv/bin/swarmsync-hook` relative to this
#      script's own location (`scripts/` next to the repo-root `.venv/`) --
#      covers settings.json wiring this script by absolute path with a PATH
#      that doesn't include the venv's bin/.

resolve_hook_bin() {
    if command -v swarmsync-hook >/dev/null 2>&1; then
        command -v swarmsync-hook
        return 0
    fi
    script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    candidate="$script_dir/../.venv/bin/swarmsync-hook"
    if [ -x "$candidate" ]; then
        echo "$candidate"
        return 0
    fi
    return 1
}

# Read the hook event once so we can both inspect it (to locate the repo being
# edited) and forward it unchanged to the adapter.
INPUT=$(cat)

# Is coordination active for THIS edit? Three signals, cheapest first:
#   1. env SWARMSYNC_ACTIVE set, OR
#   2. a .swarmsync-active marker at the session/project dir, OR
#   3. a .swarmsync-active marker at or above the edited FILE's directory.
# (3) is essential when the coordinated repo is a *subdirectory* of the session's
# project dir: CLAUDE_PROJECT_DIR then points at the parent, the marker lives in
# the sub-repo, and checking only (1)/(2) silently fails open with NO coordination.
is_active() {
    [ -n "$SWARMSYNC_ACTIVE" ] && return 0

    marker_dir="${CLAUDE_PROJECT_DIR:-$PWD}"
    [ -f "$marker_dir/.swarmsync-active" ] && return 0

    # Locate the target path from the hook payload (file_path for Edit/Write/
    # MultiEdit, notebook_path for NotebookEdit; cwd as a last resort).
    target=$(printf '%s' "$INPUT" | sed -n 's/.*"file_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
    [ -n "$target" ] || target=$(printf '%s' "$INPUT" | sed -n 's/.*"notebook_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
    [ -n "$target" ] || target=$(printf '%s' "$INPUT" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)

    dir=$(dirname -- "$target" 2>/dev/null)
    while [ -n "$dir" ] && [ "$dir" != "/" ] && [ "$dir" != "." ]; do
        [ -f "$dir/.swarmsync-active" ] && return 0
        dir=$(dirname -- "$dir")
    done

    return 1
}

if is_active; then
    if HOOK_BIN=$(resolve_hook_bin) && [ -x "$HOOK_BIN" ]; then
        # Re-feed the event we consumed above; exit with the adapter's status so a
        # DENY (non-zero) still blocks the tool call.
        printf '%s' "$INPUT" | "$HOOK_BIN" "$@"
        exit $?
    fi
fi

# Not active (or adapter unavailable): allow the tool call, do nothing.
exit 0
